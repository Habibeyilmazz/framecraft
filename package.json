{
  "name": "framecraft",
  "version": "0.1.0",
  "private": true,
  "description": "Make polished images from screenshots and code snippets, entirely in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4210 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4211 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "axe-core": "4.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "highlight.js": "^11.12.0"
  }
}
